{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "xcode": {
      "type": "local",
      "enabled": true,
      "command": ["/Applications/Xcode.app/Contents/Developer/usr/bin/mcpbridge"],
      "environment": {
        "DEVELOPER_DIR": "/Applications/Xcode.app/Contents/Developer"
      }
    }
  }
}
